# Copy this file to .env and replace every placeholder before starting the API.
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Generate a unique random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# First administrator account; password must be at least 12 characters.
ADMIN_EMAIL=admin@tusalud.local
ADMIN_PASSWORD=replace-this-with-a-unique-password
